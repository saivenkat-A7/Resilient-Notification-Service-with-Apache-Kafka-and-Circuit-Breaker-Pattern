# Copy to .env and adjust:  cp .env.example .env
# Every variable is optional - the defaults shown here are used when it is not set.

# ---- Application ----
SERVER_PORT=8080

# ---- Kafka ----
# Inside Docker Compose the broker is reachable as kafka:29092; from your host use localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP_ID=notification_group
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICAS=1
KAFKA_PRODUCER_SEND_TIMEOUT_MS=15000
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_INITIAL_INTERVAL_MS=500
KAFKA_CONSUMER_RETRY_MAX_INTERVAL_MS=5000

# ---- User Profile Service (mock endpoint hosted inside this application) ----
USER_PROFILE_SERVICE_URL=http://notification-service:8080/mock-users
USER_PROFILE_CONNECT_TIMEOUT_MS=1000
USER_PROFILE_READ_TIMEOUT_MS=2000
# Initial behaviour of the mock (changeable at runtime via POST /mock-users/admin/config)
MOCK_USER_PROFILE_FAIL=false
MOCK_USER_PROFILE_DELAY_MS=0

# ---- Circuit breaker "userProfileService" (Resilience4j) ----
CB_SLIDING_WINDOW_SIZE=10
CB_MINIMUM_NUMBER_OF_CALLS=5
CB_FAILURE_RATE_THRESHOLD=50
CB_SLOW_CALL_DURATION_THRESHOLD=1500ms
CB_WAIT_DURATION_IN_OPEN_STATE=10s
CB_PERMITTED_CALLS_IN_HALF_OPEN=3
